# GEMINI_API_KEY: Required for Gemini AI API calls (Server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# ECOSSISTEMA INTEGRADO CSB / SEMA-MT (SOMENTE ANON KEYS NO FRONTEND)
# NUNCA coloque service_role keys, senhas ou segredos privados em variáveis VITE_*
# ==============================================================================

# 1. Banco de Dados do Sistema FISCALIZA (Produtos: Vistorias, Fotos, Autos, Relatórios, Notificações)
VITE_SUPABASE_URL="https://seu-projeto-fiscaliza.supabase.co"
VITE_SUPABASE_ANON_KEY="sua_chave_anon_publica_fiscaliza"

# 2. Banco de Dados Central do Sistema ADMINISTRA BARRAGENS
# Detém o cadastro mestre padronizado: Empreendedores, Barragens, Responsáveis Técnicos e Solicitações de Alteração
VITE_ADMINISTRA_SUPABASE_URL="https://seu-projeto-administra.supabase.co"
VITE_ADMINISTRA_SUPABASE_ANON_KEY="sua_chave_anon_publica_administra"

# 3. Federação Somente Leitura dos Demais Sistemas (Opcional - Consulta de Produtos Gerados)
VITE_CLASSIFICA_SUPABASE_URL=""
VITE_CLASSIFICA_SUPABASE_ANON_KEY=""
VITE_NOTIFICA_SUPABASE_URL=""
VITE_NOTIFICA_SUPABASE_ANON_KEY=""
