# GEMINI_API_KEY: Required for Gemini AI API calls (Server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# ECOSSISTEMA INTEGRADO CSB / SEMA-MT (SOMENTE ANON KEYS NO FRONTEND)
# NUNCA coloque service_role keys, senhas ou segredos privados em variáveis VITE_*
# ==============================================================================

# 1. Banco de Dados do Sistema FISCALIZA (Produtos: Vistorias, Fotos, Autos, Relatórios, Notificações)
VITE_SUPABASE_URL="https://seu-projeto-fiscaliza.supabase.co"
VITE_SUPABASE_ANON_KEY="sua_chave_anon_publica_fiscaliza"

# 2. Integração Server-to-Server API 2.0 (S2S-V2 Ed25519) com o Sistema ADMINISTRA BARRAGENS
# SOMENTE SERVIDOR (NUNCA prefixar com VITE_ nem expor no navegador)
ADMINISTRA_API_URL=""
FISCALIZA_S2S_KEY_ID=""
FISCALIZA_S2S_PRIVATE_KEY_PEM=""

# 3. Federação Somente Leitura dos Demais Sistemas (Opcional - Consulta de Produtos Gerados)
VITE_CLASSIFICA_SUPABASE_URL=""
VITE_CLASSIFICA_SUPABASE_ANON_KEY=""
VITE_NOTIFICA_SUPABASE_URL=""
VITE_NOTIFICA_SUPABASE_ANON_KEY=""

# 4. Variáveis Exclusivas do Servidor (Rotas /api/* — NUNCA prefixar com VITE_)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# 5. Integração Server-to-Server com API Central de Solicitações de Vistoria do Administra
# SOMENTE SERVIDOR (NUNCA prefixar com VITE_ nem expor no navegador)
ADMINISTRA_SOLICITACOES_URL=""
SOLICITACOES_SERVICE_TOKEN=""


