{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)|assets/|data/|manifest\\.json$|sw\\.js$|fiscaliza_logo\\.png$).*)",
      "destination": "/index.html"
    }
  ]
}
